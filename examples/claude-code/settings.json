{
  "permissions": {
    "deny": ["Edit", "Write", "Grep", "Glob"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/redirect-read.sh"
          }
        ]
      }
    ]
  }
}
